+      this.message.on('data', (chunk: Buffer) => {
+        output = Buffer.concat([output, chunk])
+      })
+
+      this.message.on('end', () => {
+        resolve(output.toString())
+      })
+    })
+  }
+
+  async readBodyBuffer?(): Promise<Buffer> {
+    return new Promise<Buffer>(async resolve => {
+      const chunks: Buffer[] = []
